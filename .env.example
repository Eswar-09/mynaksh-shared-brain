# Shared Brain backend: "neo4j" (persistent graph) or "memory" (tests / quick local runs)
BRAIN_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mynaksh-dev

# LLM provider: "anthropic", "openai" (any OpenAI-compatible endpoint), or "fake" (offline, no key)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional overrides. Extraction can use a cheaper model than chat.
LLM_MODEL=
EXTRACTION_MODEL=
# Optional second provider used when the primary fails, e.g. "openai"
LLM_FALLBACK_PROVIDER=
